# Newsletter Automation Example
# 
# This workflow is DISABLED by default (note the .disabled extension)
# To enable: rename to newsletter-automation.yml
#
# This will automatically send newsletters when new content is added to the repo
# Customize the paths and logic to match your content publishing workflow

name: Send Newsletter on New Content

on:
  push:
    branches:
      - main
    paths:
      - 'content/geo/drafts/*.md'
      - 'src/app/guides/**/*.md'
      - 'src/app/news/**/*.md'

jobs:
  notify-subscribers:
    runs-on: ubuntu-latest
    
    steps:
      - name: Checkout code
        uses: actions/checkout@v4
        with:
          fetch-depth: 2  # Need previous commit to detect new files
      
      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: '20'
          cache: 'npm'
      
      - name: Install dependencies
        run: npm ci
      
      - name: Detect new content files
        id: detect
        run: |
          # Get list of new/modified markdown files
          NEW_FILES=$(git diff --name-only --diff-filter=A HEAD~1 HEAD | grep -E '\.(md|mdx)$' || true)
          
          if [ -z "$NEW_FILES" ]; then
            echo "No new content files detected"
            echo "has_new_content=false" >> $GITHUB_OUTPUT
            exit 0
          fi
          
          echo "New content files detected:"
          echo "$NEW_FILES"
          echo "has_new_content=true" >> $GITHUB_OUTPUT
          echo "files<<EOF" >> $GITHUB_OUTPUT
          echo "$NEW_FILES" >> $GITHUB_OUTPUT
          echo "EOF" >> $GITHUB_OUTPUT
      
      - name: Send newsletter for new content
        if: steps.detect.outputs.has_new_content == 'true'
        env:
          NEXT_PUBLIC_SUPABASE_URL: ${{ secrets.NEXT_PUBLIC_SUPABASE_URL }}
          SUPABASE_SERVICE_ROLE_KEY: ${{ secrets.SUPABASE_SERVICE_ROLE_KEY }}
          RESEND_API_KEY: ${{ secrets.RESEND_API_KEY }}
          NEWSLETTER_NOTIFY_SECRET: ${{ secrets.NEWSLETTER_NOTIFY_SECRET }}
          NEXT_PUBLIC_SITE_URL: ${{ secrets.NEXT_PUBLIC_SITE_URL }}
          WAITLIST_FROM_EMAIL: ${{ secrets.WAITLIST_FROM_EMAIL }}
        run: |
          # Parse each new file and send newsletter
          echo "${{ steps.detect.outputs.files }}" | while read -r file; do
            if [ -z "$file" ]; then
              continue
            fi
            
            echo "Processing: $file"
            
            # Determine content type based on path
            if [[ "$file" == *"/guides/"* ]]; then
              CONTENT_TYPE="guide"
              BASE_PATH="guides"
            elif [[ "$file" == *"/news/"* ]]; then
              CONTENT_TYPE="news"
              BASE_PATH="news"
            else
              echo "Skipping $file - not in guides or news directory"
              continue
            fi
            
            # Extract slug from filename (remove .md/.mdx extension)
            SLUG=$(basename "$file" | sed 's/\.(md|mdx)$//')
            
            # Extract title from frontmatter (assumes title: "..." format)
            TITLE=$(grep -m 1 '^title:' "$file" | sed 's/title: *["'"'"']\?\(.*\)["'"'"']\?/\1/' || echo "$SLUG")
            
            # Build URL
            URL="${NEXT_PUBLIC_SITE_URL}/${BASE_PATH}/${SLUG}"
            
            echo "Sending newsletter:"
            echo "  Type: $CONTENT_TYPE"
            echo "  Slug: $SLUG"
            echo "  Title: $TITLE"
            echo "  URL: $URL"
            
            # Send newsletter
            npm run notify-newsletter -- \
              --type "$CONTENT_TYPE" \
              --slug "$SLUG" \
              --title "$TITLE" \
              --url "$URL" || echo "Failed to send newsletter for $file"
          done
      
      - name: Summary
        if: always()
        run: |
          if [ "${{ steps.detect.outputs.has_new_content }}" == "true" ]; then
            echo "✅ Newsletter automation completed"
          else
            echo "ℹ️ No new content detected, newsletter not sent"
          fi

# Required GitHub Secrets:
# - NEXT_PUBLIC_SUPABASE_URL
# - SUPABASE_SERVICE_ROLE_KEY
# - RESEND_API_KEY
# - NEWSLETTER_NOTIFY_SECRET
# - NEXT_PUBLIC_SITE_URL
# - WAITLIST_FROM_EMAIL
