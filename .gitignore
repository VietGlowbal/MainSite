# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
*.log
debug.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

/tmp
# Scratch output from throwaway verification runs (rendered PDFs, text dumps).
# A glob rather than one name: these get created ad hoc during debugging and the
# next one will not be called tmp-verify either.
/tmp-*

# Python ingestion service
**/__pycache__/
**/*.py[cod]
**/.pytest_cache/
/services/data-ingestion/.venv/
/services/data-ingestion/.coverage
/services/data-ingestion/crawl_state.sqlite*
/services/data-ingestion/build/
/services/data-ingestion/src/*.egg-info/

/output
/.playwright-cli
/.codex-tmp
/.codegraph
