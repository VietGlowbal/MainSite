#!/bin/sh
set -eu

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

node_path="$(git config --local --get glowbal.nodePath || true)"
npm_exec_path="$(git config --local --get glowbal.npmExecPath || true)"

if [ ! -f "$node_path" ] || [ ! -f "$npm_exec_path" ]; then
  echo "The Git hook cannot locate Node and npm. Run npm run prepare and try again." >&2
  exit 1
fi

echo "Running the pull-request verification gate before push..."
npm_execpath="$npm_exec_path" "$node_path" scripts/verify-pr.mjs
