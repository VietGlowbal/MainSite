{
  // Strangler-fig strictness. The legacy tree (src/app, src/lib, scripts) keeps
  // the base config; every directory created during the FSD migration is
  // typechecked under the stricter flags below from the moment it exists.
  //
  // Run via `npm run typecheck:strict`. Do NOT widen `include` to cover legacy
  // paths — the point is that new code never inherits old debt.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "exactOptionalPropertyTypes": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmit": true,
    "incremental": false,
    "tsBuildInfoFile": ".strict.tsbuildinfo"
  },
  "include": [
    "next-env.d.ts",
    // Pulls in the @testing-library/jest-dom matcher augmentation (toBeInTheDocument,
    // toHaveAttribute, ...). Without it the component tests under src/shared fail to
    // typecheck here even though they pass under the base config, which includes it.
    "src/__tests__/setup.ts",
    "src/features/**/*.ts",
    "src/features/**/*.tsx",
    "src/shared/**/*.ts",
    "src/shared/**/*.tsx",
    "src/server/**/*.ts",
    "src/server/**/*.tsx"
  ],
  "exclude": ["node_modules"]
}
