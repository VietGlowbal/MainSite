    "source_key": "4c862e44eda1c561033e38c91bb0949ff1d3de9d",
    "name": "Học bổng France Excellence của Đại sứ quán Pháp tại Việt Nam",
    "slug": "hoc-bong-france-excellence-cua-dai-su-quan-phap-tai-viet-nam",
    "scope": "country",
    "country": "France",
    "provider": null,
