  {
    "source_key": "fc6af4b41ee8568df308164c16a62a75308bdcbd",
    "name": "Military & Public Service Scholarship",
    "slug": "military-public-service-scholarship",
    "scope": "university",
    "country": null,
    "provider": null,
    "funding_type": [
      "merit"
    ],
    "coverage": "Tài trợ lên tới £25,000 trừ trực tiếp vào học phí.",
    "amount_min": 25000,
    "amount_max": null,
    "amount_currency": "GBP",
    "slots": null,
    "slots_text": null,
    "eligibility": "Thí sinh mới ứng tuyển bậc Cao học (Postgraduate taught hoặc Master's research), áp dụng cho cả sinh viên bản xứ (Home) và quốc tế (Overseas), học hệ toàn thời gian (Full time) hoặc bán thời gian (Part time). Lưu ý: Không áp dụng cho học viên đang theo học tại trường",
    "applies_to_text": "Imperial College London",
    "conditions": "Ứng viên cần đang làm việc hoặc vừa kết thúc sự nghiệp trong lực lượng vũ trang, quân đội hoặc các cơ quan dịch vụ công ích. Nhà trường yêu cầu ứng viên chứng minh các yếu tố sau:\n\nCách mà môi trường quân đội hoặc dịch vụ công đã hình thành nên thế giới quan và góc nhìn của bản thân cho đến nay.\n\nĐưa ra các ví dụ rõ ràng về sự trưởng thành và phát triển cá nhân trong thời gian phục vụ.\n\nCách ứng viên dự định tận dụng những góc nhìn độc đáo này vào chương trình học MBA và sự nghiệp tương lai.\n\nCó một bộ hồ sơ tổng thể mạnh, bao gồm cả trải nghiệm chuyên môn tốt và thể hiện xuất sắc ở vòng phỏng vấn.",
    "insight": "Đây là suất học bổng hướng tới tính đa dạng hóa trải nghiệm của lớp học MBA. Trường Kinh doanh Imperial đánh giá rất cao tư duy kỷ luật, khả năng quản trị khủng hoảng và năng lực lãnh đạo từ những người có nền tảng quân đội hoặc làm việc trong khối nhà nước, dịch vụ công.\n\nĐiểm then chốt để ăn điểm là khả năng chuyển đổi năng lực (transferable skills). Bạn phải kết nối được những trải nghiệm đặc thù trong quá khứ của mình thành giá trị thực tế cho một lớp học kinh doanh thương mại. Trong bài đánh giá video, hãy tập trung vào các câu chuyện xử lý tình huống, lãnh đạo đội ngũ dưới áp lực cao và cách bạn mang tư duy đó đóng góp cho các bạn học xung quanh.",
    "deadline_date": null,
    "deadline_text": "Quyết định cấp học bổng sẽ được phản hồi trong vòng khoảng hai tuần kể từ ngày ứng viên nhận được thư mời nhập học chương trình MBA. Hạn chót xét học bổng bám sát theo hạn chót của các vòng tuyển sinh.",
    "source_url": "https://www.imperial.ac.uk/study/fees-and-funding/scholarships-search/military--public-service-scholarship-20262027.php",
    "source_lang": "mixed",
    "ranking_note": null,
    "raw": {},
    "applies_to_candidates": [
      "Imperial College London"
    ]
  },
  {
    "source_key": "c8eadc9aad26ce59a91ad1f3d2539125e330dfb5",
