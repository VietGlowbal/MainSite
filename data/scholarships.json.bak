    ],
    "coverage": "Note: Deadline: 05 December 2025\n\nValue: £21,870 stipend, full fees and £1000 per year Research Training Grant (3 years only)\nCriteria: Based on academic merit\nEligibility: UK, Overseas\nAcademic year: 2026/27\nAvailable for: Prospective students\nLevel: Graduate research degrees",
    "amount_min": 1000,
    "amount_max": 21870,
