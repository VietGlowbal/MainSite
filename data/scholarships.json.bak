    "source_key": "d3ee604058e8d760d9ea99eeac731a167ca85af2",
    "name": "Học bổng chính phủ Manaaki Scholarships (New Zealand)",
    "slug": "hoc-bong-chinh-phu-manaaki-scholarships-new-zealand",
