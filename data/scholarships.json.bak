  {
    "source_key": "77228570d5d57ae4584522efc7a783b394a039ab",
    "name": "AI for Antibody and Protein Design Studentship (Suất nghiên cứu sinh về AI trong thiết kế Kháng thể và Protein)",
    "slug": "ai-for-antibody-and-protein-design-studentship-suat-nghien-cuu-sinh-ve-ai-trong-",
    "scope": "university",
    "country": null,
    "provider": null,
    "funding_type": [
      "merit",
      "need"
    ],
    "coverage": "Tài trợ toàn phần (Fully funded studentship), bao gồm học phí và trợ cấp (mức cụ thể theo quy chuẩn chung của hội đồng nghiên cứu trường).",
    "amount_min": null,
    "amount_max": null,
    "amount_currency": null,
    "slots": 1,
    "slots_text": "1",
    "eligibility": "Thí sinh mới ứng tuyển bậc Tiến sĩ (Postgraduate doctoral), áp dụng cho cả sinh viên bản xứ (Home) lẫn sinh viên quốc tế (Overseas). Học tập theo hình thức toàn thời gian (Full-time). Lưu ý: Không áp dụng cho nghiên cứu sinh hiện tại của trường.",
    "applies_to_text": "Imperial College London",
    "conditions": "Ứng viên lý tưởng cần có đam mê lớn với lập trình (Python), tư duy định lượng và học máy (Machine Learning).\n\nĐộng lực cao trong việc ứng dụng các kỹ năng này vào lĩnh vực thiết kế cấu trúc sinh học.\n\nKinh nghiệm từ trước về ML là một điểm cộng nhưng không bắt buộc.",
    "insight": "Dự án này nằm ở rìa công nghệ giao thoa giữa AI và Sinh học tổng hợp – một xu hướng cực kỳ khát nhân lực hiện nay.\n\nVì chỉ có đúng 1 suất duy nhất, việc bạn có sẵn nền tảng Python cứng và một tư duy toán học/định lượng tốt sẽ là vũ khí cạnh tranh lớn nhất, ngay cả khi bạn chưa có nhiều kinh nghiệm sâu về AI/ML.\n\nỨng viên trúng tuyển sẽ được làm việc trong môi trường lab liên ngành, có quyền truy cập vào các bộ dữ liệu thực nghiệm lớn, các framework ML hiện đại và có cơ hội lớn để xuất bản (publish) các công cụ, tập dữ liệu mới dưới tên mình.",
    "deadline_date": null,
    "deadline_text": "Không qua cổng chung ngay từ đầu, ứng viên cần chủ động gửi thư và hồ sơ trực tiếp cho Giáo sư hướng dẫn dự án là Professor Pietro Sormanni qua email để trao đổi chi tiết.",
    "source_url": "https://www.imperial.ac.uk/study/fees-and-funding/scholarships-search/ai-for-antibody-and-protein-design-20262027.php",
    "source_lang": "mixed",
    "ranking_note": null,
    "raw": {
