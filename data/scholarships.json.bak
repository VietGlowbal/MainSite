    "source_key": "d1b2831d970dd1852a876b227276aa5670334e63",
    "name": "Excellence Grants for the Graduate Programme in Mathematics and Applicationn - Dauphine PSL",
    "slug": "excellence-grants-for-the-graduate-programme-in-mathematics-and-applicationn-dau",
